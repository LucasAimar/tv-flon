<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para instalar las actualizaciones que la app baja de GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- App solo para TV: sin pantalla táctil y con Leanback opcional,
         así también se instala en Fire TV (que no declara Leanback). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- usesCleartextTraffic: algunos streams (Radio Nacional) son http://
         Ícono y banner en drawable-* (no mipmap): el launcher de Fire TV (Fire OS 7) no
         encuentra los íconos guardados en mipmap en apps instaladas por fuera de la tienda. -->
    <application
        android:name=".TvApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvFlon"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:banner="@drawable/banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Ícono en la pantalla de inicio de Android TV y Fire TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Por si se instala en un dispositivo no-TV para probar -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte el APK descargado con el instalador del sistema -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas" />
        </provider>
    </application>
</manifest>
